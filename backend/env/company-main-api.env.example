# PACK.IT company-main backend API env example
# Copy to /opt/packit/shared/env/company-main-api.env on VPS.
# Do not commit real secrets.

PACKIT_API_PORT=8090
PACKIT_API_CORS_ORIGIN=*

PACKIT_DB_HOST=127.0.0.1
PACKIT_DB_PORT=5432
PACKIT_DB_NAME=packit_company_main
PACKIT_DB_USER=packit_app
PACKIT_DB_PASSWORD=CHANGE_ME_ON_VPS

# Optional instead of separate DB vars:
# PACKIT_DATABASE_URL=postgresql://packit_app:CHANGE_ME_ON_VPS@127.0.0.1:5432/packit_company_main
